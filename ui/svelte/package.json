{
  "name": "@qtitpcdeck/svelte",
  "version": "0.0.0",
  "private": true,
  "description": "qtitpcdeck desktop UI, built with Svelte 5.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:boundaries": "node --test boundaries.test.mjs"
  },
  "dependencies": {
    "@macro-deck/runtime": "*",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.5",
    "jsdom": "^30.0.1",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "@types/qrcode": "^1.5.6"
  }
}
